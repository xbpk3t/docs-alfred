<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>devtools</string>
	<key>version</key>
	<string>0.3.0</string>
	<key>bundleid</key>
	<string>com.devtools.lucas</string>
	<key>category</key>
	<string>Tools</string>
	<key>createdby</key>
	<string>lucas</string>
	<key>description</key>
	<string>开发者工具箱（单 Script Filter + query 状态机）</string>
	<key>disabled</key>
	<false/>
	<key>readme</key>
	<string>devtools — 单 Script Filter

交互:
  dd            → 列出 tool（base64）
  选 base64     → query 变为 base64 （valid:false + autocomplete）
  选 encode     → query 变为 base64 encode
  输入内容      → 结果 ⏎ 复制（不粘贴；transient）

Script: ./devtools "$1"
路由全在 Go；中间层 valid:false，最终层 valid:true → Clipboard。

alfredfiltersresults=false（脚本内按层 filter，避免整段 query 误滤）。
</string>
	<key>webaddress</key>
	<string>https://github.com/xbpk3t/docs-alfred</string>
	<key>connections</key>
	<dict>
		<key>SF-MAIN</key>
		<array>
			<dict>
				<key>destinationuid</key>
				<string>CLIPBOARD</string>
				<key>modifiers</key>
				<integer>0</integer>
				<key>modifiersubtext</key>
				<string></string>
				<key>vitoclose</key>
				<false/>
			</dict>
		</array>
	</dict>
	<key>objects</key>
	<array>
		<dict>
			<key>uid</key>
			<string>CLIPBOARD</string>
			<key>type</key>
			<string>alfred.workflow.output.clipboard</string>
			<key>version</key>
			<integer>3</integer>
			<key>config</key>
			<dict>
				<key>autopaste</key>
				<false/>
				<key>clipboardtext</key>
				<string>{query}</string>
				<key>ignoredynamicplaceholders</key>
				<false/>
				<key>transient</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>uid</key>
			<string>SF-MAIN</string>
			<key>type</key>
			<string>alfred.workflow.input.scriptfilter</string>
			<key>version</key>
			<integer>3</integer>
			<key>config</key>
			<dict>
				<key>alfredfiltersresults</key>
				<false/>
				<key>alfredfiltersresultsmatchmode</key>
				<integer>0</integer>
				<key>argumenttreatemptyqueryasnil</key>
				<true/>
				<key>argumenttrimmode</key>
				<integer>0</integer>
				<key>argumenttype</key>
				<integer>1</integer>
				<key>escaping</key>
				<integer>68</integer>
				<key>keyword</key>
				<string>{var:keyword}</string>
				<key>queuedelaycustom</key>
				<integer>0</integer>
				<key>queuedelayimmediatelyinitially</key>
				<true/>
				<key>queuedelaymode</key>
				<integer>1</integer>
				<key>queuemode</key>
				<integer>1</integer>
				<key>runningsubtext</key>
				<string></string>
				<key>script</key>
				<string>./devtools "$1"</string>
				<key>scriptargtype</key>
				<integer>1</integer>
				<key>scriptfile</key>
				<string></string>
				<key>subtext</key>
				<string>tool → action → input</string>
				<key>title</key>
				<string>开发者工具箱</string>
				<key>type</key>
				<integer>0</integer>
				<key>withspace</key>
				<true/>
			</dict>
		</dict>
	</array>
	<key>uidata</key>
	<dict>
		<key>CLIPBOARD</key>
		<dict>
			<key>xpos</key>
			<real>480.0</real>
			<key>ypos</key>
			<real>60.0</real>
		</dict>
		<key>SF-MAIN</key>
		<dict>
			<key>xpos</key>
			<real>160.0</real>
			<key>ypos</key>
			<real>60.0</real>
		</dict>
	</dict>
	<key>userconfigurationconfig</key>
	<array>
		<dict>
			<key>config</key>
			<dict>
				<key>default</key>
				<string>dd</string>
				<key>placeholder</key>
				<string></string>
				<key>required</key>
				<false/>
				<key>trim</key>
				<true/>
			</dict>
			<key>description</key>
			<string>Alfred 触发关键词</string>
			<key>label</key>
			<string>Keyword</string>
			<key>type</key>
			<string>textfield</string>
			<key>variable</key>
			<string>keyword</string>
		</dict>
	</array>
</dict>
</plist>
