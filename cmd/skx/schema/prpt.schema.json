{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xbpk3t/docs-alfred/main/cmd/skx/schema/prpt.schema.json",
  "title": "prpt",
  "description": "JSON Schema for zzz prompt YAML files (references/**/*.yml)。唯一 source of truth（模板 prpt.yml 已并入本 schema 的描述）。\n顶层 section：frontmatter / what / gate / constraint / input / workflow / output / self-check / hint。\n- prompts 直接以 .yml 形态被 route/Read，无渲染层。\n- composite 用 workflow 组织阶段；phase 的 steps 里可用 {kind: prompt, name} 串行调度其他 prompt（sub-agent）。\n- 调度纪律（ledger）见 SKILL.md；`skx check` 校验本 schema；`skx graph` 看依赖/环（避免 loop hell，环检测由 cli 处理）。",
  "type": "object",
  "properties": {
    "frontmatter": {
      "type": "object",
      "description": "(必填) frontmatter 命名空间；至少含 name+role",
      "properties": {
        "name": {
          "type": "string",
          "description": "(必填) 等于文件名 stem（路由名）"
        },
        "role": {
          "type": "string",
          "enum": ["atom", "composite"],
          "description": "(必填) 可选值 atom | composite；composite 时必须有 workflow"
        },
        "desc": {
          "type": "string",
          "description": "(可选) 短说明，给自己看，非 trigger；多行用 | 块"
        },
        "status": {
          "type": "string",
          "enum": ["active", "draft", "deprecated"],
          "description": "(可选) 状态；省略即 active"
        }
      },
      "required": ["name", "role"],
      "additionalProperties": false
    },

    "what": {
      "type": "object",
      "description": "(必填) 这个 prompt 是什么 / 不是什么",
      "properties": {
        "is": { "type": "string", "description": "(可选) 一句话说明它是什么" },
        "not": {
          "type": "string",
          "description": "(可选) 一句话说明它不是什么（边界/反模式）"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },

    "gate": {
      "type": "array",
      "description": "(可选) 入口闸门（先答，不满足则不进入）",
      "items": {
        "type": "object",
        "properties": {
          "qs": { "type": "string", "description": "(必填) 问什么" },
          "fail": { "type": "string", "description": "(必填) 不满足则怎样" }
        },
        "required": ["qs", "fail"],
        "additionalProperties": false
      }
    },

    "constraint": {
      "type": "object",
      "description": "(可选) 硬约束；含各 dispatch 步的适用性规则（何时跑/跳过）",
      "properties": {
        "must": {
          "type": "array",
          "items": { "type": "string" },
          "description": "(可选) 必须遵守的规则"
        },
        "must-not": {
          "type": "array",
          "items": { "type": "string" },
          "description": "(可选) 禁止做的事（反模式）"
        }
      },
      "additionalProperties": false
    },

    "input": {
      "type": "object",
      "description": "(可选) 输入要求/参数声明",
      "properties": {
        "source": {
          "type": "string",
          "description": "(可选) 输入来源文件路径"
        },
        "params": {
          "type": "array",
          "items": { "type": "object" },
          "description": "(可选) 参数列表，每项一个自由对象（如 {mode: default | heavy}）"
        }
      },
      "additionalProperties": false
    },

    "workflow": {
      "type": "array",
      "description": "(composite 必填；atom 可选) 阶段化流程（复杂 prompt 用）。phase 的 steps 里可用 {kind: prompt, name} 串行调度其他 prompt（起 sub-agent）。适用性/并入规则放 constraint 与 output。",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "description": "(必填) 宏观板块（Phase）"
          },
          "gate": { "type": "string", "description": "(可选) 进入条件" },
          "desc": { "type": "string", "description": "(可选) 做什么" },
          "steps": {
            "type": "array",
            "description": "(可选) 该 phase 内的微观动作：string=普通操作；{kind: prompt, name}=串行调度其他 prompt（sub-agent，纪律见 SKILL.md ledger）；父 agent 只编排汇总。",
            "items": {
              "oneOf": [
                { "type": "string", "description": "普通操作（默认 kind）" },
                {
                  "type": "object",
                  "description": "dispatch 步：串行起 sub-agent 运行目标 prompt",
                  "required": ["kind", "name"],
                  "properties": {
                    "kind": { "const": "prompt", "description": "(必填) dispatch 类型" },
                    "name": { "type": "string", "description": "(必填) 目标 prompt stem（references 里必须存在）" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["phase"],
        "additionalProperties": false
      }
    },

    "output": {
      "type": "object",
      "description": "(可选，但强烈建议；高频) 输出契约：产出什么形态 + 产出物落不落盘；含各 dispatch 步产物并入位置",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["yaml", "table", "md"],
          "description": "(可选) 可选值 yaml | table | md"
        },
        "struct": {
          "type": "array",
          "description": "(可选) 输出字段语义表",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "description": "(必填) 字段名" },
              "val": {
                "type": ["string", "number", "boolean"],
                "description": "(必填) 示例或该字段 enum 值"
              }
            },
            "required": ["key", "val"],
            "additionalProperties": false
          }
        },
        "template": {
          "type": "string",
          "description": "(可选) 输出模板 codeblock；描述各 dispatch 步产物并入位置"
        },
        "few-shot": { "type": "string", "description": "(可选) 示例输入输出" },
        "persist": {
          "type": "object",
          "description": "(可选) 产出物落盘行为；persist 存在即表示要落盘",
          "properties": {
            "enabled": { "type": "boolean", "description": "(可选) 落盘开关，默认 true" },
            "path": { "type": "string", "description": "(必填) 落盘路径（相对 workspace）" }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "self-check": {
      "type": "array",
      "items": { "type": "string" },
      "description": "(可选) 交付前自检项（yes/no）"
    },

    "hint": {
      "type": "array",
      "description": "(可选；高频；交付必给) 条件式推进/下一步提示。每项 {if, then}：if=触发条件，then=建议动作（recall/deepen/write/skip…）。旧 string 形式已废弃。",
      "items": {
        "type": "object",
        "properties": {
          "if": { "type": "string", "description": "(必填) 触发条件" },
          "then": {
            "type": "string",
            "description": "(必填) 满足条件时的建议动作"
          }
        },
        "required": ["if", "then"],
        "additionalProperties": false
      }
    }
  },
  "required": ["frontmatter", "what"],
  "additionalProperties": false,

  "if": {
    "properties": {
      "frontmatter": { "properties": { "role": { "const": "composite" } } }
    }
  },
  "then": {
    "required": ["workflow"]
  }
}
