{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xbpk3t/docs-alfred/main/internal/gh/schema/diary.schema.json",
  "title": "diary",
  "description": "JSON Schema for data/diary YAML files. Each file is a list of daily entries. Only date is required; des/score/url are optional. Unknown fields are rejected.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["date"],
    "additionalProperties": false,
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "des": {
        "type": ["string", "null"]
      },
      "score": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "url": {
        "type": "string",
        "pattern": "^https?://"
      }
    }
  }
}
