{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xbpk3t/docs-alfred/main/internal/gh/schema/books.schema.json",
  "title": "books",
  "description": "JSON Schema for data/books YAML files (books.*.yml) 与 data/ntl YAML 文件 (movie/TV/music) 共用的内容收藏 schema。Root 是扁平的 topic 列表，每个 topic 持有一张 table 行。行级 key 严格枚举（additionalProperties false）：共享 name/author/score/publishAt/des/readAt/url/record/qs，ntl 另有 dict/cast；嵌套内容表 (row.table / row.topics) 保持 free-form。",
  "type": "array",
  "items": {
    "$ref": "#/$defs/topic"
  },
  "$defs": {
    "topic": {
      "type": "object",
      "required": [
        "topic"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "des": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableItem"
          }
        },
        "record": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "qs": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "des": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "tableItem": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "publishAt": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        },
        "des": {
          "type": [
            "string",
            "null"
          ]
        },
        "readAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "qs": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "record": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "dict": {
          "type": "string"
        },
        "cast": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
