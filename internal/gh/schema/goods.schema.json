{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xbpk3t/docs-alfred/main/internal/gh/schema/goods.schema.json",
  "title": "goods",
  "description": "JSON Schema for data/goods YAML files (goods.*.yml). Field sets verified against all goods files including hidden .goods.*.yml. Topics are flat (one level, no recursion); there is no kind/repo/rel.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/topic"
  },
  "$defs": {
    "topic": {
      "type": "object",
      "required": [
        "topic"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "des": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableItem"
          }
        },
        "record": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "qs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "what": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "htu": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hto": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "des": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "tableItem": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "商品项；key 严格枚举（additionalProperties false），行必有 name；endDate/endPrice/isUsing 均为可选生命周期字段",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "param": {
          "type": "string"
        },
        "des": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "record": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "isUsing": {
          "type": "boolean"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endPrice": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "dependentRequired": {
        "endPrice": [
          "endDate"
        ]
      }
    }
  }
}
