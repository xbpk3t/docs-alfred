{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xbpk3t/docs-alfred/main/internal/gh/schema/gh.schema.json",
  "title": "gh",
  "description": "JSON Schema for data/gh YAML files. Root is a flat topic list (one topic item per file entry); the section type is derived from the file name rather than stored. Field sets derived from a data audit; cross-field and cross-file business rules stay in Go.",
  "type": "array",
  "items": { "$ref": "#/$defs/topic" },
  "$defs": {
    "topic": {
      "type": "object",
      "required": ["topic", "kind"],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "minLength": 1,
          "enum": ["mech", "type", "repo", "tools", "temp"],
          "description": "topic 类型；gh 必填"
        },
        "des": {
          "type": ["string", "null"],
          "description": "topic 描述（goods 使用）"
        },
        "repo": { "type": "array", "items": { "$ref": "#/$defs/repo" } },
        "record": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "table": { "type": "array", "items": { "$ref": "#/$defs/tableItem" } },
        "what": { "type": "array", "items": { "type": "string" } },
        "why": { "type": "array", "items": { "type": "string" } },
        "ww": { "type": "array", "items": { "type": "string" } },
        "htu": { "type": "array", "items": { "type": "string" } },
        "hti": { "type": "array", "items": { "type": "string" } },
        "hto": { "type": "array", "items": { "type": "string" } },
        "qs": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },

    "repo": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "des": { "type": ["string", "null"] },
        "nix": { "type": "string", "pattern": "^https?://" },
        "doc": { "type": "string", "pattern": "^https?://" },
        "score": { "type": "integer", "minimum": 0, "maximum": 5 },
        "isDotfiles": { "type": "boolean" },
        "zk": { "type": "string" },
        "record": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "rel": { "type": "array", "items": { "$ref": "#/$defs/repo" } },
        "qs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "record": {
      "type": "object",
      "required": ["date"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "des": { "type": ["string", "null"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 5 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },

    "tableItem": {
      "type": "object",
      "additionalProperties": true,
      "description": "对比表项；内容异构（name/what/why/where/when/brand/price/lang 等），dynamic key 不做枚举"
    }
  }
}
